{
  "manifest_version": 3,
  "name": "S3 Bucket Viewer",
  "version": "0.1.0",
  "description": "Browse, upload, copy, move and delete S3 objects from a Chrome side panel. Credentials stay local.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "S3 Bucket Viewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "sidePanel", "downloads"],
  "host_permissions": [
    "https://*.amazonaws.com/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "optional_host_permissions": ["https://*/*"]
}
